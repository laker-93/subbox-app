# Staging environment URLs
VITE_PYMIX_URL=https://pymix.staging.sub-box.net
VITE_NAVIDROME_USER_URL=https://navidrome{user}.staging.sub-box.net
VITE_FILEBROWSER_URL=https://browser.staging.sub-box.net/browser

# Local library directory (sibling of Electron's userData dir).
VITE_SUBBOX_APP_DIR=subbox

# Only used by the Electron build — see the note in .env.development.
VITE_LEGAL_URL=https://www.staging.sub-box.net/legal
