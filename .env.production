# Production environment URLs
VITE_PYMIX_URL=https://pymix.sub-box.net
VITE_NAVIDROME_USER_URL=https://navidrome{user}.sub-box.net
VITE_FILEBROWSER_URL=https://browser.sub-box.net/browser

# Local library directory (sibling of Electron's userData dir).
VITE_SUBBOX_APP_DIR=subbox

# VITE_DEMO_PASSWORD is deliberately NOT set here — this repo is public. It is passed
# as a Docker build arg from the DEMO_PASSWORD repository secret (see Dockerfile and
# .github/workflows/publish-docker-hub.yml). Unset, the landing page's "Try the demo"
# button doesn't render, which is what desktop and self-hosted builds want.
