# Development environment URLs
VITE_PYMIX_URL=https://pymix.docker.localhost
VITE_NAVIDROME_USER_URL=https://navidrome{user}.docker.localhost
VITE_FILEBROWSER_URL=https://browser.docker.localhost/browser

# Local library directory (sibling of Electron's userData dir). The `-dev`
# suffix isolates the dev library from a staging/production `subbox` collection
# on the same machine.
VITE_SUBBOX_APP_DIR=subbox-dev

# In prod the demo login browses demoadmin's Navidrome container, because `demo`
# has no container of its own. A dev stack has no demoadmin, so point it at the
# dev `demo` account itself — which /user/create does give a container.
VITE_DEMO_NAVIDROME_USER=demo

# VITE_DEMO_PASSWORD is deliberately NOT set here. It's the one value that's a
# credential rather than a URL, and setting it is also what makes the "Try the
# demo" button render — so a checkout that hasn't created a local `demo` account
# yet gets no button, rather than one that fails on click. To enable it, see
# .env.development.local.example.
